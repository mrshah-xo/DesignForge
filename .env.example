# Copy this file to .env and fill in real values. NEVER commit .env.

# Prisma Postgres (cloud). For long-running servers use the direct URL;
# on Vercel/serverless use the pooled URL as DATABASE_URL instead.
DATABASE_URL="postgres://<user>:<password>@db.prisma.io:5432/postgres?sslmode=require"

# Pooled connection (PgBouncer) — recommended DATABASE_URL value on Vercel.
DATABASE_URL_POOLED="postgres://<user>:<password>@pooled.db.prisma.io:5432/postgres?sslmode=require"

# AI (Z.AI Open Platform, GLM models). The server reads credentials from the
# environment; create a free API key in your Z.AI account, then set:
# ZAI_BASE_URL="https://api.z.ai/api/paas/v4"
# ZAI_API_KEY="..."
# Optional companions: ZAI_CHAT_ID, ZAI_USER_ID, ZAI_TOKEN
# Optional model picks: ZAI_TEXT_MODEL, ZAI_TEXT_MODEL_FALLBACK, ZAI_VISION_MODEL
#
# Local alternative to env vars: put the same fields in .ai-credentials.json
# at the project root (gitignored). It can also point at a mounted secret:
#   { "credentialsFile": "/run/secrets/ai_gateway.json" }
