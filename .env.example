# Copy this file to .env and fill in real values. NEVER commit .env.

# Prisma Postgres (cloud). For long-running servers use the direct URL;
# on Vercel/serverless use the pooled URL as DATABASE_URL instead.
DATABASE_URL="postgres://<user>:<password>@db.prisma.io:5432/postgres?sslmode=require"

# Pooled connection (PgBouncer) — recommended DATABASE_URL value on Vercel.
DATABASE_URL_POOLED="postgres://<user>:<password>@pooled.db.prisma.io:5432/postgres?sslmode=require"

# Z.AI credentials are read from /etc/ai-gateway.json automatically.
# On deployments without filesystem access (e.g. Vercel) set these instead —
# they are the same fields as ai-gateway.json (baseUrl / apiKey / chatId / userId / token):
# ZAI_BASE_URL="https://..."
# ZAI_API_KEY="..."
# ZAI_CHAT_ID="..."
# ZAI_USER_ID="..."
# ZAI_TOKEN="..."
